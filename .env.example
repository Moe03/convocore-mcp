# ConvoCore Configuration (stdio / local npx)
WORKSPACE_SECRET=your_workspace_secret_here

# Optional: Choose API region (eu-gcp or na-gcp)
CONVOCORE_API_REGION=eu-gcp

# Optional: Full REST base URL override (overrides region when set).
# CONVOCORE_API_BASE_URL=http://localhost:5000/v3

# Optional: Override ONLY the /interact WebSocket URL.
# CONVOCORE_INTERACT_WS_URL=ws://localhost:5000/interact

# Used by `pnpm publish:npm`
NPM_ACCESS_TOKEN=

# --- Hosted Streamable HTTP (Dockerfile.hosted / docker-compose.hosted.yml) ---
# Container always listens on 3009. Point mcp.convocore.ai → this host:3009
PORT=3009
HOST=0.0.0.0
MCP_HTTP_PATH=/mcp
CONVOCORE_HOSTED_ALLOWED_HOSTS=mcp.convocore.ai
CONVOCORE_HOSTED_DNS_PROTECTION=true
# Idle MCP transport session cleanup (ms). Default ~1 year. Set 0 to never evict.
CONVOCORE_HOSTED_SESSION_IDLE_MS=31536000000
# Public HTTPS origin for OAuth discovery (Claude custom connectors).
CONVOCORE_PUBLIC_BASE_URL=https://mcp.convocore.ai

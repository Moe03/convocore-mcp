{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "convocore": {
      "type": "streamable-http",
      "url": "https://mcp.convocore.ai/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "cimd" },
            "registrationUrl": "https://mcp.convocore.ai/oauth/register",
            "resource": "https://mcp.convocore.ai/mcp",
            "baseScopes": ["mcp", "convocore"]
          }
        }
      }
    }
  }
}
